# Copy to .env and fill in your own values. Never commit .env.

# Path to your local Obsidian vault (active workspace)
VAULT_PATH="/path/to/your/obsidian/vault"

# Path to your wiki / knowledge substrate (optional)
WIKI_PATH="/path/to/your/wiki"

# HTTP port for the MCP server
PORT=3000

# Google OAuth (optional — only needed for Gmail/Calendar tools)
# Generate a refresh token once with: bun scripts/get-google-token.ts
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""
